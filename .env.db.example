# ════════════════════════════════════════════════════════════════════════════
# HOST-DB env — database-only host (docker-compose.db.yml)
# ════════════════════════════════════════════════════════════════════════════
# Copy to `.env.db` on the Postgres host and fill in. This host runs ONE
# container: Postgres. The control plane (NestJS core, Redis, edge nginx,
# frontend) runs on a SEPARATE host (see .env.core.example), and the Go data
# plane on a third (see .env.transfer.example).
#
# Usage:  docker compose --env-file .env.db -f docker-compose.db.yml up -d
#
# Bring this host up FIRST — backend-core runs `prisma db push` at boot and
# exits if the database is unreachable.

# ─── Bind address (REQUIRED) ────────────────────────────────────────────────
# DB_PRIVATE_IP — the private-NIC IP THIS host publishes Postgres on.
#   NEVER 0.0.0.0 (that exposes the database to the public LAN). Firewall 5432
#   to the core host only. The container always listens on 5432 internally;
#   DB_PORT only changes the host-side port.
DB_PRIVATE_IP=10.0.0.9

# ─── Credentials (REQUIRED) ─────────────────────────────────────────────────
# POSTGRES_PASSWORD — the SAME value must be written into DATABASE_URL on the
#   core host. The wizard on the db host generates one when left blank; copy it
#   over out-of-band. Printed at the end of `./install.sh --topology=db`.
# POSTGRES_USER / POSTGRES_DB — role and database created on first boot.
#   backend-core's DATABASE_URL must use the same triple.
POSTGRES_USER=tele_drive
POSTGRES_DB=tele_drive
POSTGRES_PASSWORD=change-this-to-a-strong-random-secret

# ─── Optional ───────────────────────────────────────────────────────────────
# DB_PORT — host-side port for Postgres (default 5432). Change only when
#   something else already owns 5432 on this host; the core host then needs the
#   matching DB_PORT.
# DB_PORT=5432
#
# Server tuning. The defaults below are sized for a 2-4 GB host; raise them on a
# bigger box (shared_buffers ≈ 25% of RAM, max_connections ≈ 2-3x the core
# host's Prisma pool).
# POSTGRES_MAX_CONNECTIONS=200
# POSTGRES_SHARED_BUFFERS=256MB

# ─── On the CORE host (.env.core) ───────────────────────────────────────────
# DB_HOST=10.0.0.9
# DB_PORT=5432
# POSTGRES_USER=tele_drive
# POSTGRES_DB=tele_drive
# POSTGRES_PASSWORD=<same value as here>
#
# The wizard derives DATABASE_URL from those; by hand it is:
# DATABASE_URL=postgresql://tele_drive:<password>@10.0.0.9:5432/tele_drive
#
# Then deploy core WITH the external-db overlay so it never starts its own
# Postgres container:
#   docker compose --env-file .env.core \
#     -f docker-compose.core.yml -f docker-compose.core.extdb.yml up -d

# ─── Backups ────────────────────────────────────────────────────────────────
# Nothing here schedules backups. Minimum viable:
#   docker compose --env-file .env.db -f docker-compose.db.yml \
#     exec -T postgres pg_dump -U tele_drive -Fc tele_drive > tele_drive.dump
# Restore:
#   docker compose ... exec -T postgres pg_restore -U tele_drive -d tele_drive --clean < tele_drive.dump
