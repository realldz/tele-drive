# ════════════════════════════════════════════════════════════════════════════
# HOST-CORE env — control-plane host (docker-compose.core.yml)
# ════════════════════════════════════════════════════════════════════════════
# Copy to `.env.core` on the control-plane host and fill in. This host runs
# NestJS core, Postgres, Redis, the public edge nginx, and the frontend. The Go
# data plane runs on a SEPARATE host (see .env.transfer.example).
#
# Usage:  docker compose --env-file .env.core -f docker-compose.core.yml up -d
#
# Bring this host up FIRST — the Go host blocks up to 60s waiting for the core
# gRPC server.

# ─── Cross-host wiring (REQUIRED) ─────────────────────────────────────────────
# GO_HOST — host/IP of the Go data-plane host, reachable over the PRIVATE network.
#   Used three ways on this host:
#     - GO_TRANSFER_GRPC_URL = dns:///${GO_HOST}:50051  (NestJS → Go gRPC)
#     - TRANSFER_API_URL     = http://${GO_HOST}:3001   (purge delegation)
#     - GO_UPSTREAM (edge)   = ${GO_HOST}:3001          (data-plane proxy)
#   Must match a SAN entry on the Go leaf cert (re-issue certs before splitting).
GO_HOST=10.0.0.2

# CORE_PRIVATE_IP — the private-NIC IP THIS host binds Redis + the gRPC server to.
#   NEVER 0.0.0.0 (that would expose Redis/gRPC to the public LAN). Redis (6379)
#   and the core gRPC server (50051) bind only here; firewall both to GO_HOST.
CORE_PRIVATE_IP=10.0.0.1

# UPLOAD_BUFFER_NFS — path to the shared upload buffer, mounted on BOTH hosts.
#   Go writes chunks here; NestJS (this host) deletes them on abort/delete and
#   reads directory size for stats. Use the SAME NFS export on both hosts.
#   Example NFS client mount target, or a bind path backed by an NFS mount.
UPLOAD_BUFFER_NFS=/mnt/tele-drive-buffer

# ─── Redis password (REQUIRED) ───────────────────────────────────────────────
# Interpolated into redis --requirepass and every REDIS_URL. The Go host reuses
# the SAME password to connect across the private network. Keep both .env files
# in sync. Generate with:
#   openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 40
REDIS_PASSWORD=change-this-to-a-strong-random-secret

# ─── Public domains / SSL (edge nginx) ────────────────────────────────────────
# APP_DOMAIN — public app domain. Self-signed cert auto-generated if none found.
# APP_DOMAIN=myapp.example.com
# S3_DOMAIN  - dedicated S3-compatible API domain. Must match backend/.env.
#   The frontend reads it at runtime (GET /api/v1/client-config); the
#   placeholder s3.example.com counts as "not configured" on the keys page.
# S3_DOMAIN=s3.example.com
# SSL_CERT_FILE=cert.pem
# SSL_KEY_FILE=key.pem

# ─── Optional: edge nginx ports ──────────────────────────────────────────────
# NGINX_PORT=80
# NGINX_SSL_PORT=443

# ─── Optional: scale the data plane across multiple Go hosts ──────────────────
# GO_UPSTREAM — the edge data-plane upstream list. Defaults to "${GO_HOST}:3001"
#   (single Go host). To load-balance the edge across SEVERAL Go hosts, set a
#   comma/space-separated list of host:port — entrypoint-edge.sh expands it into
#   the go_data_plane upstream (round_robin + passive health ejection). Each host
#   runs its own docker-compose.transfer.yml and shares this host's Redis + NFS.
# GO_UPSTREAM=10.0.0.2:3001,10.0.0.3:3001,10.0.0.4:3001

# ─── Optional: transfer-domain origin (absolute data-plane URLs) ──────────────
# When set (e.g. https://transfer.example.com), NestJS core emits ABSOLUTE URLs
# for data-plane download/stream/zip links AND serves the same origin to the
# browser at runtime (GET /api/v1/client-config), so the frontend routes its
# data-plane XHR + stream URLs there without a rebuild. When empty/unset, links
# stay RELATIVE and the frontend keeps using NEXT_PUBLIC_API_URL (single-origin).
# No trailing slash needed (normalized). Requires CORS_ORIGIN +
# STREAM_COOKIE_SAMESITE on the transfer domain once it differs. Lives in
# backend/.env (backend-core reads it via env_file).
# PUBLIC_TRANSFER_URL=

# ─── Optional: frontend ──────────────────────────────────────────────────────
# Baked at build time. Default /api/v1.
# NEXT_PUBLIC_API_URL=/api/v1
# There are no NEXT_PUBLIC_* knobs for the data plane or S3 anymore: the
# frontend fetches both at runtime from GET /api/v1/client-config, which is
# sourced from PUBLIC_TRANSFER_URL and S3_DOMAIN above. The S3 placeholder
# "s3.example.com" counts as unconfigured (keys page shows a warning).

# ─── Optional: prebuilt images from GHCR (docker-compose.core.ghcr.yml) ───────
# CI publishes every image to GitHub Container Registry; the pull-only overlay
# runs them instead of building from source:
#   docker compose --env-file .env.core \
#     -f docker-compose.core.yml -f docker-compose.core.ghcr.yml pull
#   docker compose --env-file .env.core \
#     -f docker-compose.core.yml -f docker-compose.core.ghcr.yml up -d
# TELE_DRIVE_IMAGE_TAG — latest (default), master, sha-<short>, or a release tag
#   (1.2.3). MUST match the tag used by the Go host (docker-compose.transfer.
#   ghcr.yml) — a mixed tag means a Go/NestJS version skew over gRPC.
# TELE_DRIVE_IMAGE_PREFIX — registry path, default ghcr.io/realldz/tele-drive.
# TELE_DRIVE_IMAGE_TAG=latest

# ─── Optional: CDN data-plane cache (docs/cdn-cache/README.md) ───────────────
# These ENV values are seeded ONCE into SystemSetting at backend-core boot
# (rows for keys absent). The Go data plane reads them via gRPC from that same
# table — so setting them HERE (control host) covers everything; no need to
# duplicate on the data-plane host. Dashboard edits later always win.
#
# CDN_CACHE_MODE — cache policy for signed download/stream responses:
#   disabled  (default) — every response private, no-store
#   revalidate          — no-cache + strong ETag (origin re-checks per request)
#   full                — public, max-age=CDN_CACHE_TTL_SECONDS (quota-free hits)
# CDN_CACHE_MODE=disabled
#
# CDN_CACHE_TTL_SECONDS — TTL for `full` mode (clamped 30..604800; default 3600).
# CDN_CACHE_TTL_SECONDS=3600
#
# CDN_CACHE_WINDOW_SECONDS — signed-token exp quantization window (0 = off).
#   When the mode is not disabled, exp snaps up to this bucket so repeated
#   requests in one window mint the same token → stable CDN cache keys.
#   Trade-off: token outlives its nominal TTL by up to W-1 seconds. Recommend 300.
# CDN_CACHE_WINDOW_SECONDS=0
#
# CDN_CACHE_MODE_PUBLIC_S3 — per-surface override for the PUBLIC S3 route
# (/public/<userId>/<bucket>/<key>, served by backend-core NestJS).
#   inherit (default) — follow CDN_CACHE_MODE; revalidate/full/disabled force.
# Public buckets hold immutable content without a per-user credential;
# `full` pairs best with the Cloudflare purge provider below.
# CDN_CACHE_MODE_PUBLIC_S3=inherit
# Purge on permanent delete (optional). Provider none = no-op. Only the
# control host (FrankJS core) runs the purge service.
#   CDN_PURGE_PROVIDER=none|cloudflare
#   CLOUDFLARE_API_TOKEN    token with Zone.Cache Purge permission
#   CDN_CACHE_PURGE_ZONE    Cloudflare zone ID
#   CDN_CACHE_PURGE_BASE    public origin serving data-plane routes
#                           (falls back to PUBLIC_TRANSFER_URL above)
# CDN_PURGE_PROVIDER=none